    {
      "id": "update-deferral",
      "sourceKeys": [
        "softwareUpdatesEnforcedDelayInDays",
        "enforcedSoftwareUpdateDelayInDays",
        "com.apple.applicationaccess/enforcedSoftwareUpdateDelay"
      ],
      "classification": "DDM_SEMANTIC",
      "targetPath": "com.apple.configuration.softwareupdate.settings/Deferrals/CombinedPeriodInDays",
      "appleSupport": "Supported",
      "intuneSupport": "Listed in DDM catalogue; resolve tenant definition/template",
      "minimumIOS": "18.0",
      "supervisionRequired": true,
      "valueType": "integer",
      "minimum": 1,
      "maximum": 90,
      "notes": "Review the companion force-delay enable flag before generating a candidate. iOS uses CombinedPeriodInDays, not separate macOS major/minor periods. Deferral hides updates; it is not an installation deadline.",
      "sources": [
        "https://github.com/apple/device-management/blob/release/declarative/declarations/configurations/softwareupdate.settings.yaml",
        "https://learn.microsoft.com/en-us/intune/device-configuration/settings-catalog/ref-apple-settings"
      ]
    },
    {
      "id": "update-deferral-enable",
      "sourceKeys": [
        "softwareUpdatesForceDelayed",
        "com.apple.applicationaccess/forceDelayedSoftwareUpdates"
      ],
      "classification": "DDM_PARTIAL",
      "targetPath": "com.apple.configuration.softwareupdate.settings/Deferrals",
      "notes": "The enable flag has no stand-alone target. Review with its delay value; false means no deferral should be generated.",
      "sources": [
        "https://github.com/apple/device-management/blob/release/declarative/declarations/configurations/softwareupdate.settings.yaml"
      ]
    },
    {
      "id": "update-schedule",
      "sourceKeys": [
        "updateScheduleType",
        "scheduledInstallDays",
        "scheduledInstallTime",
        "scheduledInstallTimeUtc",
        "updateTimeWindowStartTime",
        "updateTimeWindowEndTime"
      ],
      "classification": "REQUIRES_REVIEW",
      "targetPath": "com.apple.configuration.softwareupdate.enforcement.specific",
      "notes": "A recurring legacy window does not specify a target OS and local deadline. Do not invent either. Administrator must design enforcement intent.",
      "sources": [
        "https://github.com/apple/device-management/blob/release/declarative/declarations/configurations/softwareupdate.enforcement.specific.yaml"
      ]
    },
